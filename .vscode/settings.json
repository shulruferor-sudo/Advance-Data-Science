{
  "files.autoSave": "afterDelay",
  "git.autofetch": true,
  "git.autofetchPeriod": 90,
  "git.confirmSync": false,
  "gitdoc.enabled": true,
  "gitdoc.autoCommitDelay": 15000,
  "gitdoc.autoPush": "onCommit",
  "gitdoc.autoPull": "off",
  "gitdoc.pullOnOpen": false,
  "gitdoc.pushMode": "push",
  "gitdoc.commitValidationLevel": "error",
  "gitdoc.commitOnClose": false,
  "gitdoc.filePattern": "**/*",
  "gitdoc.ai.enabled": false,
  "python.defaultInterpreterPath": "/usr/local/bin/python",
  "jupyter.askForKernelRestart": false
}
