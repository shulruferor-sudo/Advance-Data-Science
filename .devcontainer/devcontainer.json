{
  "name": "Advance Data Science",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "python .devcontainer/setup.py && python .devcontainer/verify.py",
  "waitFor": "updateContentCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "vsls-contrib.gitdoc"
      ]
    }
  }
}
